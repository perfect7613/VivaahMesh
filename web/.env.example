# Copy to .env.local and fill in. Never commit real values.

# Supabase (Dashboard → Project Settings → API, or `supabase projects api-keys --project-ref <ref>`)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only

# Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=                 # server only
TELEGRAM_BOT_USERNAME=vivaah_bot
TELEGRAM_WEBHOOK_SECRET=            # any random string; `openssl rand -hex 16`

# Public https URL of this app (Vercel URL or an ngrok/cloudflared tunnel for local bot testing)
APP_URL=https://vivaahmesh.vercel.app

# Local only: lets the Mini App run in a normal browser with a fake user. Ignored in production.
DEV_AUTH_BYPASS=1

# Sarvam AI (dashboard.sarvam.ai), server only
SARVAM_API_KEY=

# Flagsmith: server-side environment key (Settings → Keys). Admin key is only for scripts/flagsmith-setup.mjs.
FLAGSMITH_SERVER_KEY=
FLAGSMITH_ADMIN_API_KEY=

# Sarvam Samvaad vendor calls (see docs/samvaad-agent.md)
SARVAM_VOICE_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE=
DEMO_VENUE_PHONE=
DEMO_VENUE_NAME=
DEMO_VENUE_LANGUAGE=Hindi
OPS_SECRET=

# Until a Sarvam number is connected: simulated, clearly labelled venue answers
DEMO_REHEARSAL_CALLS=1

# Agent web search + page reading
FIRECRAWL_API_KEY=

# Sarvam Model APIs and optional prepared household note
SARVAM_MODEL_API_KEY=
VIVAAHMESH_DEMO_WEDDING_ID=

# HMAC for per-call webhook tokens and dictation drafts (32+ chars)
CALLS_WEBHOOK_SECRET=

# NudgeBee ops events (sk-nb- platform token) and optional explicit cluster account
NUDGEBEE_API_KEY=
NUDGEBEE_ACCOUNT_ID=

# Set to worker once the Azure result worker is ready. Inline is the default.
CALL_RESULT_PROCESSOR=inline
# Secret URL for the NudgeBee event workflow, including its integration token.
NUDGEBEE_EVENT_WEBHOOK_URL=

# Optional 32+ character key for rotating wedding realtime topics independently.
WEDDING_REALTIME_SECRET=

# Optional WhatsApp bridge, server-side only
BRIDGE_SECRET=
WHATSAPP_PLAN_URL=
